# Satellite Image Sorter & Organizer Backend Environment Configuration

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated; in production, add your Vercel deployment URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Storage Paths (Optional overrides, relative to project root or absolute)
# UPLOAD_DIR=uploads
# SAMPLE_DIR=sample_images
# ORGANIZED_DIR=Organized

# Upload Limits
MAX_UPLOAD_SIZE_BYTES=52428800
